---
import Logo from './Logo.astro';
import { useTraductions } from '../i18n';

const t = useTraductions();
const annee = new Date().getFullYear();
---
<footer class="border-t border-gray-200 bg-white">
  <div class="degrade h-1" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div>
      <Logo class="h-10" />
      <p class="mt-3 font-titre font-semibold text-gris">{t.footer.slogan}</p>
    </div>
    <nav aria-label="Liens légaux">
      <ul class="flex flex-col gap-2 sm:flex-row sm:gap-6">
        <li><a href="/mentions-legales" class="text-encre underline-offset-4 hover:underline">{t.footer.mentions}</a></li>
        <li><a href="/confidentialite" class="text-encre underline-offset-4 hover:underline">{t.footer.confidentialite}</a></li>
      </ul>
    </nav>
  </div>
  <p class="pb-8 text-center text-sm text-gris">© {annee} {t.footer.droits}</p>
</footer>
